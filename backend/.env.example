# Server
PORT=3000
AUTO_MIGRATE=true

# PostgreSQL + PostGIS (Render/Neon/Supabase provide a DATABASE_URL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vibecity
DATABASE_SSL=false

# Optional API keys (leave blank to run without live social/Places data)
YOUTUBE_API_KEY=
META_OAUTH_TOKEN=
GOOGLE_MAPS_API_KEY=